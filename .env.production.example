# Copy to .env for Docker Compose. Use two distinct domains.
APP_DOMAIN=qr.example.com
QR_DOMAIN=go.example.com
ACME_EMAIL=owner@example.com
# Use a long alphanumeric password to keep the database URL unambiguous.
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_ALPHANUMERIC_PASSWORD
ALLOW_REGISTRATION=true

APP_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Relay <noreply@example.com>
