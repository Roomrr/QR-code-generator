{
  "name": "relay-qr",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch --watch-path=server --watch-path=shared --watch-path=.env server/index.js",
    "dev:web": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node scripts/test-runner.js unit",
    "db:migrate": "node scripts/migrate.js",
    "db:backup": "node scripts/backup.js export",
    "db:restore": "node scripts/backup.js import",
    "test:e2e": "node scripts/test-runner.js browser",
    "format": "prettier --write src shared server scripts tests *.js *.json *.yaml README.md",
    "admin:promote": "node scripts/promote-admin.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.4.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
    "knex": "^3.1.0",
    "lucide-react": "^0.468.0",
    "nanoid": "^5.1.6",
    "nodemailer": "^10.1.0",
    "pg": "^8.16.3",
    "qr-code-styling": "^1.9.2",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "smtp-server": "^3.19.21",
    "supertest": "^7.1.4",
    "vite": "^7.1.10"
  }
}
