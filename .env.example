NODE_ENV=development
PORT=3001
HOST=0.0.0.0
APP_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5173
QR_BASE_URL=http://localhost:3001
# PostgreSQL: create this database yourself. DATABASE_URL optionally overrides DB_*.
DB_NAME=relay
DB_USER=relay
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DATABASE_URL=
DATABASE_SSL=false
# SMTP: EMAIL_USE_TLS=true uses STARTTLS except implicit TLS on port 465.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
OTP_HOURLY_LIMIT=5
# Generate locally: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
APP_SECRET=
SESSION_DAYS=7
COOKIE_SECURE=false
ALLOW_REGISTRATION=true
TRUST_PROXY=0
CONTACT_EMAIL=
BUSINESS_NAME=
GOOGLE_SITE_VERIFICATION=
# Promote a verified account with: npm run admin:promote -- owner@example.com
# Frontend: keep blank for same-origin API proxy.
VITE_API_URL=
API_PROXY_URL=
